        {
          "atoms": [
            {
              "relation": "Consommation_CSP",
              "terms": {
                "Conso_moyenne_annuelle": {
                  "derived": {
                    "inputs": [
                      "NB_KW_Jour"
                    ],
                    "expression": "NB_KW_Jour * 365",
                    "aggregate": "avg"
                  }
                }
              }
            }
          ]
        },
        {
          "atoms": [
            {
              "relation": "Consommation_IRIS_Evry",
              "terms": {
                "Conso_moyenne_annuelle": {
                  "derived": {
                    "inputs": [
                      "NB_KW_Jour"
                    ],
                    "expression": "NB_KW_Jour * 365",
                    "aggregate": "avg"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "source": "Source3_CSP",
      "containment": "sound",
      "queries": [
        {
          "atoms": [
            {
              "relation": "Consommation_CSP",
              "terms": {
                "ID_CSP": "ID_CSP",
                "Salaire_Moyen": "Salaire_Moyen"
              }
            }
          ]
        }
      ]
    },
    {
      "source": "Source4_IRIS",
      "containment": "sound",
      "queries": [
        {
          "atoms": [
            {
              "relation": "Consommation_IRIS_Paris",
              "terms": {
                "ID_Iris": "ID_Iris"
              }
            }
          ],
          "conditions": [
            {
              "column": "ID_Ville",
              "op": "=",
              "value": "Paris"
            }
          ]
        },
        {
          "atoms": [
            {
              "relation": "Consommation_IRIS_Evry",
              "terms": {
                "ID_Iris": "ID_Iris"
              }
            }
          ]
        }
      ],
      "description": "Côté Évry, la jointure actuelle ne porte que sur le nom de rue : aucune condition sur ID_Ville n'est exprimée."
    }
