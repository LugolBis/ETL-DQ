  "mappings": [
    {
      "source": "Source1_Population",
      "containment": "sound",
      "queries": [
        {
          "atoms": [
            {
              "relation": "Consommation_CSP"
            }
          ]
        }
      ]
    },
    {
      "source": "Source1_Consommation",
      "containment": "sound",
      "queries": [
        {
          "atoms": [
            {
              "relation": "Consommation_CSP",
              "terms": {
                "Conso_moyenne_annuelle": {
                  "derived": {
                    "inputs": [
                      "NB_KW_Jour"
                    ],
                    "expression": "NB_KW_Jour * 365",
                    "aggregate": "avg"
                  }
                }
              }
            }
          ]
        },
        {
          "atoms": [
            {
              "relation": "Consommation_IRIS_Paris",
              "terms": {
                "Conso_moyenne_annuelle": {
                  "derived": {
                    "inputs": [
                      "NB_KW_Jour"
                    ],
                    "expression": "NB_KW_Jour * 365",
                    "aggregate": "avg"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "source": "Source2_Population",
      "containment": "sound",
      "queries": [
        {
          "atoms": [
            {
              "relation": "Consommation_CSP",
              "terms": {
